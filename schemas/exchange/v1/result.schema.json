{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mercury.local/schemas/exchange/v1/result.schema.json",
  "title": "ExchangeResultV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "task_id", "status", "attempt_id", "produced_at", "inputs", "transcription", "dictionaries", "artifacts", "review", "calls", "warnings", "error", "next_action", "extensions"],
  "properties": {
    "contract": { "const": "mercury.result/v1" },
    "task_id": { "$ref": "common.schema.json#/$defs/taskId" },
    "status": { "enum": ["queued", "running", "pausing", "paused", "needs_input", "completed", "failed", "cancelled", "interrupted"] },
    "attempt_id": { "type": ["string", "null"], "maxLength": 100 },
    "produced_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "inputs": {
      "type": "array", "maxItems": 10,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["kind", "sha256", "source"],
        "properties": {
          "kind": { "enum": ["media", "transcript", "reference"] },
          "sha256": { "$ref": "common.schema.json#/$defs/sha256" },
          "source": { "enum": ["provider", "provided", "reference"] }
        }
      }
    },
    "transcription": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "asr_call_count", "transcript_path", "transcript_sha256"],
      "properties": {
        "mode": { "enum": ["provider", "provided", "unknown"] },
        "asr_call_count": { "type": ["integer", "null"], "minimum": 0 },
        "transcript_path": { "anyOf": [{ "type": "null" }, { "$ref": "common.schema.json#/$defs/absolutePath" }] },
        "transcript_sha256": { "anyOf": [{ "type": "null" }, { "$ref": "common.schema.json#/$defs/sha256" }] }
      }
    },
    "dictionaries": {
      "type": "object", "additionalProperties": false,
      "required": ["snapshots", "conflict_count", "match_count"],
      "properties": {
        "snapshots": { "type": "array", "maxItems": 32, "items": { "$ref": "common.schema.json#/$defs/dictionaryReference" } },
        "conflict_count": { "type": ["integer", "null"], "minimum": 0 },
        "match_count": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "artifacts": { "type": "array", "maxItems": 20, "items": { "$ref": "common.schema.json#/$defs/artifact" } },
    "review": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "pending_count", "approved"],
      "properties": {
        "status": { "enum": ["unsupported", "not_ready", "pending", "in_progress", "ready", "not_required", "finalized", "invalid"] },
        "pending_count": { "type": ["integer", "null"], "minimum": 0 },
        "approved": { "type": "boolean" }
      }
    },
    "delivery": { "$ref": "#/$defs/delivery" },
    "calls": {
      "type": "array", "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["provider", "capability", "count", "outcome"],
        "properties": {
          "provider": { "type": "string", "minLength": 1, "maxLength": 100 },
          "capability": { "enum": ["transcription", "calibration"] },
          "count": { "type": "integer", "minimum": 0 },
          "outcome": { "enum": ["not_dispatched", "known_terminal", "response_persisted", "outcome_unknown", "mixed", "unknown"] }
        }
      }
    },
    "warnings": { "type": "array", "maxItems": 1000, "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
    "error": { "anyOf": [{ "type": "null" }, { "$ref": "error.schema.json" }] },
    "next_action": { "type": "string", "minLength": 1, "maxLength": 1000, "pattern": "\\S" },
    "extensions": { "$ref": "common.schema.json#/$defs/extensions" }
  },
  "$defs": {
    "delivery": {
      "type": "object", "additionalProperties": false,
      "required": ["requested_directory", "status", "final_path", "sha256", "validation", "delivered_at", "review_revision", "history", "error", "next_action"],
      "properties": {
        "requested_directory": { "anyOf": [{ "type": "null" }, { "$ref": "common.schema.json#/$defs/absolutePath" }] },
        "status": { "enum": ["not_requested", "unsupported", "pending_review", "ready", "delivered", "failed"] },
        "final_path": { "anyOf": [{ "type": "null" }, { "$ref": "common.schema.json#/$defs/absolutePath" }] },
        "sha256": { "anyOf": [{ "type": "null" }, { "$ref": "common.schema.json#/$defs/sha256" }] },
        "validation": { "enum": ["passed", "unavailable"] },
        "delivered_at": { "anyOf": [{ "type": "null" }, { "$ref": "common.schema.json#/$defs/timestamp" }] },
        "review_revision": { "type": ["string", "null"], "pattern": "^rev-[a-f0-9]{20}$" },
        "history": {
          "type": "array", "maxItems": 1000,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["path", "sha256", "review_revision", "delivered_at"],
            "properties": {
              "path": { "$ref": "common.schema.json#/$defs/absolutePath" },
              "sha256": { "$ref": "common.schema.json#/$defs/sha256" },
              "review_revision": { "type": "string", "pattern": "^rev-[a-f0-9]{20}$" },
              "delivered_at": { "$ref": "common.schema.json#/$defs/timestamp" }
            }
          }
        },
        "error": { "anyOf": [{ "type": "null" }, { "$ref": "error.schema.json" }] },
        "next_action": { "type": "string", "minLength": 1, "maxLength": 1000, "pattern": "\\S" }
      }
    }
  }
}
