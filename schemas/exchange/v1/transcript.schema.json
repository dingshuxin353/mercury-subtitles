{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mercury.local/schemas/exchange/v1/transcript.schema.json",
  "title": "ExchangeTranscriptV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "transcript_id", "created_at", "language", "duration_ms", "text", "segments", "source", "warnings", "extensions"],
  "properties": {
    "contract": { "const": "mercury.transcript/v1" },
    "transcript_id": { "type": "string", "pattern": "^trn-[a-f0-9]{16,64}$" },
    "created_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "language": { "type": "string", "minLength": 2, "maxLength": 35 },
    "duration_ms": { "type": ["integer", "null"], "minimum": 1 },
    "text": { "type": "string", "minLength": 1, "maxLength": 2000000, "pattern": "\\S" },
    "segments": {
      "type": "array", "minItems": 1, "maxItems": 100000,
      "items": { "$ref": "#/$defs/segment" }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "format", "original_path", "original_sha256", "normalized_sha256"],
      "properties": {
        "kind": { "enum": ["provider", "provided"] },
        "format": { "enum": ["provider_json", "srt", "vtt", "transcript_json"] },
        "original_path": { "anyOf": [{ "type": "null" }, { "$ref": "common.schema.json#/$defs/absolutePath" }] },
        "original_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
        "normalized_sha256": { "$ref": "common.schema.json#/$defs/sha256" }
      }
    },
    "warnings": { "type": "array", "maxItems": 1000, "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
    "extensions": { "$ref": "common.schema.json#/$defs/extensions" }
  },
  "$defs": {
    "word": {
      "type": "object", "additionalProperties": false,
      "required": ["text", "start_ms", "end_ms", "confidence"],
      "properties": {
        "text": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "\\S" },
        "start_ms": { "type": "integer", "minimum": 0 },
        "end_ms": { "type": "integer", "minimum": 1 },
        "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
      }
    },
    "segment": {
      "type": "object", "additionalProperties": false,
      "required": ["segment_id", "index", "start_ms", "end_ms", "text", "words"],
      "properties": {
        "segment_id": { "type": "string", "pattern": "^seg-[a-f0-9]{8,64}$" },
        "index": { "type": "integer", "minimum": 0 },
        "start_ms": { "type": "integer", "minimum": 0 },
        "end_ms": { "type": "integer", "minimum": 1 },
        "text": { "type": "string", "minLength": 1, "maxLength": 10000, "pattern": "\\S" },
        "words": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/word" } }
      }
    }
  }
}
