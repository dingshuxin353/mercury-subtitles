{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mercury.local/schemas/exchange/v1/request.schema.json",
  "title": "ExchangeRequestV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "request_id", "created_at", "operation", "inputs", "transcription_mode", "calibration", "models", "dictionaries", "output", "extensions"],
  "properties": {
    "contract": { "const": "mercury.exchange.request/v1" },
    "request_id": { "$ref": "common.schema.json#/$defs/requestId" },
    "created_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "operation": { "const": "subtitle_calibration" },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["media", "transcript"],
      "properties": {
        "media": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object", "additionalProperties": false,
              "required": ["path", "sha256", "mime_type"],
              "properties": {
                "path": { "$ref": "common.schema.json#/$defs/absolutePath" },
                "sha256": { "$ref": "common.schema.json#/$defs/sha256" },
                "mime_type": { "const": "audio/mpeg" }
              }
            }
          ]
        },
        "transcript": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object", "additionalProperties": false,
              "required": ["path", "sha256", "format", "role"],
              "properties": {
                "path": { "$ref": "common.schema.json#/$defs/absolutePath" },
                "sha256": { "$ref": "common.schema.json#/$defs/sha256" },
                "format": { "enum": ["srt", "vtt", "transcript_json"] },
                "role": { "enum": ["transcript_source", "reference"] }
              }
            }
          ]
        }
      }
    },
    "transcription_mode": { "enum": ["provider", "provided"] },
    "calibration": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "source_language"],
      "properties": {
        "mode": { "enum": ["text-only", "text-and-segmentation"] },
        "source_language": { "type": "string", "minLength": 2, "maxLength": 35 }
      }
    },
    "models": {
      "type": "object", "additionalProperties": false,
      "required": ["asr", "chat"],
      "properties": {
        "asr": { "type": ["string", "null"], "minLength": 1, "maxLength": 100 },
        "chat": { "type": "string", "minLength": 1, "maxLength": 100 }
      }
    },
    "dictionaries": {
      "type": "object", "additionalProperties": false,
      "required": ["project_key", "selected", "task_overrides"],
      "properties": {
        "project_key": { "type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$" },
        "selected": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "pattern": "^dict-[a-z0-9][a-z0-9-]{2,63}$" } },
        "task_overrides": { "type": "array", "maxItems": 100, "items": { "$ref": "dictionary.schema.json#/$defs/entry" } }
      }
    },
    "output": {
      "type": "object", "additionalProperties": false,
      "required": ["formats", "workspace_policy"],
      "properties": {
        "formats": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["srt", "report"] } },
        "workspace_policy": { "const": "managed" },
        "approved_srt_directory": { "$ref": "common.schema.json#/$defs/absolutePath" }
      }
    },
    "extensions": { "$ref": "common.schema.json#/$defs/extensions" }
  }
}
