{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mercury.local/schemas/v1/calibration-result.schema.json",
  "title": "CalibrationResult",
  "x-mercury-invariant-id": "INV-CAL-003-C",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "created_at",
    "status",
    "request",
    "model_snapshot_ref",
    "call",
    "suggestions",
    "warnings",
    "errors"
  ],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/SchemaVersion" },
    "task_id": { "$ref": "common.schema.json#/$defs/ProtocolId" },
    "created_at": { "$ref": "common.schema.json#/$defs/Timestamp" },
    "status": {
      "type": "string",
      "enum": ["completed", "failed"]
    },
    "request": { "$ref": "#/$defs/CalibrationRequest" },
    "model_snapshot_ref": { "$ref": "common.schema.json#/$defs/ProtocolId" },
    "call": { "$ref": "common.schema.json#/$defs/CallRecord" },
    "suggestions": {
      "type": "array",
      "items": { "$ref": "#/$defs/CalibrationSuggestion" }
    },
    "warnings": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/WarningRecord" }
    },
    "errors": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/ErrorRecord" }
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/CompletedState" },
    { "$ref": "#/$defs/FailedState" }
  ],
  "$defs": {
    "CompletedState": {
      "x-mercury-invariant-id": "INV-CAL-003-C",
      "type": "object",
      "properties": {
        "status": { "const": "completed" },
        "call": {
          "allOf": [
            { "$ref": "common.schema.json#/$defs/CallRecord" },
            { "type": "object", "properties": { "outcome": { "const": "completed" } } }
          ]
        },
        "errors": { "type": "array", "maxItems": 0 }
      }
    },
    "FailedState": {
      "x-mercury-invariant-id": "INV-CAL-003-F",
      "type": "object",
      "properties": {
        "status": { "const": "failed" },
        "call": {
          "allOf": [
            { "$ref": "common.schema.json#/$defs/CallRecord" },
            { "type": "object", "properties": { "outcome": { "const": "failed" } } }
          ]
        },
        "suggestions": { "type": "array", "maxItems": 0 },
        "errors": { "type": "array", "minItems": 1 }
      }
    },
    "CalibrationMode": {
      "type": "string",
      "enum": ["text-only", "text-and-segmentation"]
    },
    "CalibrationRequest": {
      "x-mercury-invariant-id": "INV-CAL-001",
      "type": "object",
      "additionalProperties": false,
      "required": ["transcript_ref", "reference_srt_ref", "mode"],
      "properties": {
        "transcript_ref": { "const": "work/transcript.raw.json" },
        "reference_srt_ref": {
          "oneOf": [
            { "const": "input/reference.srt" },
            { "type": "null" }
          ]
        },
        "mode": {
          "oneOf": [
            { "$ref": "#/$defs/CalibrationMode" },
            { "type": "null" }
          ]
        }
      }
    },
    "CalibrationSuggestion": {
      "x-mercury-invariant-id": "INV-CAL-003-C",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "suggestion_id",
        "kind",
        "source_segment_refs",
        "start_ms",
        "end_ms",
        "original_text",
        "suggested_text",
        "rationale",
        "confidence",
        "disposition",
        "disposition_reason"
      ],
      "properties": {
        "suggestion_id": { "$ref": "common.schema.json#/$defs/ProtocolId" },
        "kind": {
          "type": "string",
          "enum": ["text_correction", "segmentation", "timing"]
        },
        "source_segment_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/ProtocolId" }
        },
        "start_ms": { "$ref": "common.schema.json#/$defs/NonNegativeMilliseconds" },
        "end_ms": { "$ref": "common.schema.json#/$defs/PositiveMilliseconds" },
        "original_text": { "$ref": "common.schema.json#/$defs/NonBlankString" },
        "suggested_text": { "$ref": "common.schema.json#/$defs/NonBlankString" },
        "rationale": { "$ref": "common.schema.json#/$defs/NonBlankString" },
        "confidence": { "type": "string", "enum": ["low", "medium", "high"] },
        "disposition": { "type": "string", "enum": ["applied", "not_applied"] },
        "disposition_reason": {
          "type": "string",
          "enum": [
            "accepted_by_rules",
            "insufficient_evidence",
            "mode_disallows_change",
            "invalid_timeline",
            "out_of_scope"
          ]
        }
      },
      "if": { "properties": { "disposition": { "const": "applied" } }, "required": ["disposition"] },
      "then": { "properties": { "disposition_reason": { "const": "accepted_by_rules" } } },
      "else": {
            "properties": {
              "disposition_reason": {
                "enum": [
                  "insufficient_evidence",
                  "mode_disallows_change",
                  "invalid_timeline",
                  "out_of_scope"
                ]
              }
            }
      }
    }
  },
  "x-mercury-semantic-checks": [
    { "check": "calibration-request-mode", "invariant_id": "INV-CAL-001" },
    { "check": "calibration-suggestion-time-ranges", "invariant_id": "INV-GEN-003" },
    { "check": "calibration-text-only-policy", "invariant_id": "INV-CAL-002" },
    { "check": "calibration-unique-ids", "invariant_id": "INV-GEN-004" },
    { "check": "calibration-completed-consistency", "invariant_id": "INV-CAL-003-C" },
    { "check": "calibration-failed-consistency", "invariant_id": "INV-CAL-003-F" },
    { "check": "artifact-created-after-terminal-records", "invariant_id": "INV-GEN-003" },
    { "check": "artifact-diagnostic-links", "invariant_id": "INV-GEN-004" },
    { "check": "no-sensitive-provider-config", "invariant_id": "INV-SEC-001" },
    { "check": "no-sensitive-model-metadata", "invariant_id": "INV-SEC-001" }
  ]
}
